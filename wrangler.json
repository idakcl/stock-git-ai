{
  "name": "stock-git-ai",
  "main": "web/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,

  "routes": [
    { "pattern": "stock-git-ai.1234.nyc.mn", "custom_domain": true }
  ],

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "vars": {
    "GITHUB_OWNER": "idakcl",
    "GITHUB_REPO": "stock-git-ai-data",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://stock-git-ai.1234.nyc.mn,http://localhost:5173,http://localhost:4173"
  },

  "observability": {
    "enabled": true
  }
}
