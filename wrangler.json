{
  "name": "stock-git-ai",
  "main": "web/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,

  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "vars": {
    "GITHUB_OWNER": "idakcl",
    "GITHUB_REPO": "stock-git-ai-data",
    "GITHUB_BRANCH": "main"
  },

  "observability": {
    "enabled": true
  }
}
